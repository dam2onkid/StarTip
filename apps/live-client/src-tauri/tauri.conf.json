{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StarTip Live Event Client",
  "version": "0.1.0",
  "identifier": "com.startip.live-client",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "StarTip Live Event Client",
        "width": 420,
        "height": 560,
        "resizable": true,
        "minimizable": true,
        "maximizable": false,
        "closable": true,
        "focus": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": false,
    "targets": ["dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
